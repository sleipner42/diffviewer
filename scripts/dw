#!/bin/sh
set -eu

install_url="https://raw.githubusercontent.com/sleipner42/diffviewer/main/install.sh"

case "${1:-}" in
  update)
    exec sh -c "curl -fsSL $install_url | sh"
    ;;
  -V|--version|-h|--help)
    exec diffviewer "$1"
    ;;
esac

binary="$(command -v diffviewer 2>/dev/null || true)"
if [ -z "$binary" ]; then
  echo "dw: diffviewer is not installed; run: curl -fsSL $install_url | sh" >&2
  exit 1
fi

# Sort the arguments into a directory and an optional base..head range.
target=""
range=""
for arg in "$@"; do
  if [ -d "$arg" ]; then
    [ -z "$target" ] && target="$arg" && continue
    echo "dw: more than one directory given" >&2
    exit 1
  fi
  case "$arg" in
    ./*|../*|/*|~*)
      # Written as a path, so report it as a missing directory even though a
      # leading "../" would otherwise parse as a range with an empty base.
      echo "dw: $arg is not a directory" >&2
      exit 1
      ;;
    *..*)
      if [ -n "$range" ]; then
        echo "dw: more than one range given" >&2
        exit 1
      fi
      range="$arg"
      ;;
    *)
      echo "dw: $arg is not a directory" >&2
      exit 1
      ;;
  esac
done
[ -z "$target" ] && target="."

# The app is launched detached, so its stderr is gone. Check the range here to
# keep a typo an immediate terminal error rather than a window that never opens.
if [ -n "$range" ]; then
  base="${range%%..*}"
  head="${range##*..}"
  [ -z "$head" ] && head="HEAD"
  for rev in "$base" "$head"; do
    if ! git -C "$target" rev-parse --verify -q "$rev^{commit}" >/dev/null 2>&1; then
      echo "dw: $rev is not a valid revision" >&2
      exit 1
    fi
  done
fi

nohup "$binary" "$target" ${range:+"$range"} >/dev/null 2>&1 &
